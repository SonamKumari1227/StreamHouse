# StreamHouse — local environment.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. Everything here is local-only:
# no cloud accounts, no API keys, nothing that costs money. The two external APIs
# used from Phase 4 (Open-Meteo, Nager.Date) are free and need no key at all.
#
# ---------------------------------------------------------------------------
# Why every variable is prefixed SH_
#
# Docker Compose gives the HOST shell environment precedence over this file.
# A plain `POSTGRES_USER` exported in your shell for some unrelated project would
# silently win over the value here, and Postgres would initialise with the wrong
# role — a failure that only surfaces later as "role does not exist".
# The SH_ prefix makes a collision effectively impossible.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- Postgres (OLTP source)
SH_POSTGRES_USER=streamhouse
SH_POSTGRES_PASSWORD=streamhouse_local_dev
SH_POSTGRES_DB=streamhouse
SH_POSTGRES_PORT=5432

# ---------------------------------------------------------------- Redpanda
SH_REDPANDA_PORT=9092          # Kafka API
SH_SCHEMA_REGISTRY_PORT=8081   # built-in schema registry
SH_CONSOLE_PORT=8080           # Redpanda Console web UI

# ---------------------------------------------------------------- Kafka Connect
SH_CONNECT_PORT=8083

# ---------------------------------------------------------------- MinIO (S3A object store)
# MinIO rejects a root password shorter than 8 characters.
SH_MINIO_ROOT_USER=streamhouse
SH_MINIO_ROOT_PASSWORD=streamhouse_local_dev
SH_MINIO_PORT=9000
SH_MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------- Spark
SH_SPARK_UI_PORT=8090
SH_SPARK_WORKER_CORES=2
SH_SPARK_WORKER_MEMORY=2g
